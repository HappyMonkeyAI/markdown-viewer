# Local OpenCode / Unsloth AgentWorld lane (optional)
# Copy to .env — never commit .env
#   cp .env.example .env
#
# Not required to build or run Markdown Viewer.

# Unsloth Studio base URL (your machine or LAN host)
UNSLOTH_STUDIO_URL=http://127.0.0.1:8888

# Studio API key (keep out of git)
UNSLOTH_API_KEY=

# Model id as accepted by `unsloth start opencode --model`
AGENTWORLD_MODEL=unsloth/Qwen-AgentWorld-35B-A3B-GGUF:UD-IQ4_NL

# Optional: default worktree task id prefix when using --worktree without name
# LANE_TASK_PREFIX=aw
