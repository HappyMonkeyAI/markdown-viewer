# Local OpenCode / Unsloth AgentWorld lane (copy to .env — never commit .env)
#   cp .env.example .env

# Unsloth Studio on LAN (already running model server)
UNSLOTH_STUDIO_URL=http://192.168.5.157:8888

# Local Studio API key (LAN-only is fine; still keep out of git)
UNSLOTH_API_KEY=

# Model id as accepted by `unsloth start opencode --model`
AGENTWORLD_MODEL=unsloth/Qwen-AgentWorld-35B-A3B-GGUF:UD-IQ4_NL

# Optional: default worktree task id prefix when using --worktree without name
# LANE_TASK_PREFIX=aw
