{
  "name": "markdown-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Windows 11 markdown file viewer with double-click open",
  "main": "main.js",
  "author": "steph",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "smoke": "node scripts/smoke.js",
    "dist": "electron-builder --win dir portable nsis --x64",
    "dist:dir": "electron-builder --win dir --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:nsis": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "local.markdown-viewer",
    "productName": "Markdown Viewer",
    "copyright": "Copyright © local",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "fixtures/sample.md",
      "build/icon.ico",
      "package.json"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown",
        "description": "Markdown Document",
        "role": "Viewer"
      },
      {
        "ext": "markdown",
        "name": "Markdown",
        "description": "Markdown Document",
        "role": "Viewer"
      },
      {
        "ext": "mdown",
        "name": "Markdown",
        "description": "Markdown Document",
        "role": "Viewer"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "MarkdownViewer-${version}-portable.exe"
    },
    "forceCodeSigning": false
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "highlight.js": "^11.11.1",
    "jsdom": "^26.1.0",
    "marked": "^15.0.12",
    "marked-highlight": "^2.2.1"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  }
}
